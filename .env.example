# =============================================================================
# ENVIRONMENT VARIABLES FOR NEVERLAND MONEY
# =============================================================================
# Copy this file to .env and fill in your actual API keys
# Never commit your actual .env file to git!

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Protocol stats data sources (both have production defaults and are optional)
# NEXT_PUBLIC_TVL_ENDPOINT=https://app.neverland.money/api/neverland/protocol-stats
# NEXT_PUBLIC_ENVIO_GRAPHQL_URL=https://index.neverland.money/v1/graphql

# Next.js Environment (usually handled automatically)
# NODE_ENV=development

# Custom Port (default is 3000)
# PORT=3000
